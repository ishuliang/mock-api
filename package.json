{
  "name": "personal-mock-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal lightweight mock API server with TypeScript and SQLite.",
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
